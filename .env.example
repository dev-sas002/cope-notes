# Settings for a host checkout. The app reads the process environment only, so
# copy this to .env (ignored by git) and load it with: set -a; . ./.env; set +a
# docker-compose.yml sets its own values and does not read this file.

# PostgreSQL and Redis
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0

# Mail
APP_URL=http://localhost:3000
MAILER_FROM_ADDRESS=notes@cope-notes.example
# Production only:
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Delivery pipeline
DELIVERY_INTERVAL_MINUTES=1
DELIVERY_BATCH_SIZE=1000
DELIVERY_SPREAD_SECONDS=0
DELIVERY_CHANNEL=email
NOTE_SELECTION_STRATEGY=random_unsent
SIDEKIQ_CONCURRENCY=10

# Optional: model-based screening. Leave empty to use the offline reviewer.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_TIMEOUT_SECONDS=10

# Optional: basic auth for /sidekiq (both must be set)
SIDEKIQ_WEB_USERNAME=
SIDEKIQ_WEB_PASSWORD=
