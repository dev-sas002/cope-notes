<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cope Notes</title>
  </head>
  <%#
    Mail clients strip <style> blocks and rarely support flexbox or grid, so the
    layout is a centred table and every rule is inline. Colours are stated
    explicitly - a client that forces its own dark theme should still leave
    readable contrast.
  %>
  <body style="margin:0; padding:0; background-color:#f4f2ee;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background-color:#f4f2ee; padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                 style="max-width:520px; background-color:#ffffff; border-radius:12px;
                        border:1px solid #e4e0d8; font-family:-apple-system,BlinkMacSystemFont,
                        'Segoe UI',Helvetica,Arial,sans-serif;">
            <%= yield %>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
