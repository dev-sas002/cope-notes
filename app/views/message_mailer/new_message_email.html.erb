<tr>
  <td style="padding:28px 32px 0 32px;">
    <p style="margin:0; font-size:12px; letter-spacing:0.08em; text-transform:uppercase;
              color:#8a8578;">Cope Notes</p>
  </td>
</tr>
<tr>
  <td style="padding:20px 32px 0 32px;">
    <p style="margin:0; font-size:16px; line-height:1.5; color:#3f3a33;">
      Hi <%= @subscriber.name %>,
    </p>
  </td>
</tr>
<tr>
  <td style="padding:16px 32px 0 32px;">
    <p style="margin:0; font-size:20px; line-height:1.55; color:#1f1c18;">
      <%= @message.text %>
    </p>
  </td>
</tr>
<tr>
  <td style="padding:28px 32px 28px 32px;">
    <hr style="border:0; border-top:1px solid #e4e0d8; margin:0 0 16px 0;" />
    <p style="margin:0; font-size:13px; line-height:1.6; color:#8a8578;">
      One note, once in a while. You will never be sent the same note twice.
      Reply to this email and a person will read it.
    </p>
  </td>
</tr>
