<tr>
  <td style="padding:32px 32px 0 32px;">
    <p style="margin:0; font-size:12px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase;
              color:#4f6f5b;">Cope Notes</p>
  </td>
</tr>
<tr>
  <td style="padding:20px 32px 0 32px;">
    <p style="margin:0; font-size:16px; line-height:1.5; color:#6b645a;">
      Hi <%= @subscriber.name %>,
    </p>
  </td>
</tr>
<tr>
  <td style="padding:12px 32px 0 32px;">
    <p style="margin:0; padding-left:16px; border-left:3px solid #a9bfae;
              font-family:Georgia,'Times New Roman',serif; font-size:22px; line-height:1.5; color:#2b2620;">
      <%= @message.text %>
    </p>
  </td>
</tr>
<tr>
  <td style="padding:32px 32px 28px 32px;">
    <hr style="border:0; border-top:1px solid #e3dccf; margin:0 0 16px 0;" />
    <p style="margin:0 0 8px 0; font-size:13px; line-height:1.6; color:#6b645a;">
      One note, once in a while. You will never be sent the same note twice.
      Reply to this email and a person will read it.
    </p>
    <p style="margin:0; font-size:13px; line-height:1.6; color:#6b645a;">
      Would rather not hear from us?
      <a href="<%= @unsubscribe_url %>" style="color:#3c5646; text-decoration:underline;">Unsubscribe</a>
    </p>
  </td>
</tr>
